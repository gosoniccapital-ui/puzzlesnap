# Cronjob keep-alive (Optional)
CRONJOB_API_KEY=your_cronjob_api_key_here

# Admin Portal & Security (Sprint 6.1)
ADMIN_MASTER_PASSWORD=your_strong_admin_passcode_here
ADMIN_SESSION_SECRET=your_32_character_hmac_secret_here

# AI Vision & Stylist Engine (Milestone 6.5)
GEMINI_API_KEY=your_google_gemini_api_key_here

